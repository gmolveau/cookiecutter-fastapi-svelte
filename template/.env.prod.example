# see `docs/env.md`
### Domains
APP_DOMAIN=

### Backend
# CORS
ALLOWED_HOSTS=<DOMAIN>,localhost
ALLOWED_ORIGINS=

# Auth Keycloak / OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZE_URL=
OIDC_ACCESS_TOKEN_URL=
OIDC_JWT_URL=
OIDC_REQUIRE_EMAIL_VERIFIED=true

# Session
SESSION_SECRET_KEY=
SESSION_COOKIE_MAX_AGE=

# Storage (local | s3)
STORAGE_DRIVER=
# required when STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
# required when STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# optional (s3)
# STORAGE_S3_PREFIX=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Database
DATABASE_URL=

# Environment
APP_ENV=
# required in prod: git tag; also selects the Docker image tag
APP_VERSION=

# Rate limiting (slowapi format: "N/second|minute|hour|day")
RATE_LIMIT=

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=

# OpenTelemetry (optional)
OTEL_ENABLED=
OTEL_SERVICE_NAME=
# required only when OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

### Frontend
PUBLIC_API_URL=
PUBLIC_BASE_URL=

### Docker
DATA_VOLUME=
