# see `docs/env.md`
### Backend
# CORS
ALLOWED_HOSTS="app.localhost,localhost:5173,localhost"
ALLOWED_ORIGINS="http://app.localhost,http://localhost:5173"

# Auth Keycloak / OIDC
OIDC_CLIENT_ID=the-app
OIDC_CLIENT_SECRET=L0nrBUABwIm3ghXrrXmoX76BJ6xjzDvy_wzDff6rKQ0
OIDC_AUTHORIZE_URL=http://keycloak.localhost/realms/myrealm/protocol/openid-connect/auth
OIDC_ACCESS_TOKEN_URL=http://keycloak.localhost/realms/myrealm/protocol/openid-connect/token
OIDC_JWT_URL=http://keycloak.localhost/realms/myrealm/protocol/openid-connect/certs
OIDC_REQUIRE_EMAIL_VERIFIED=false
# uncomment when running without docker compose
# OIDC_AUTHORIZE_URL=http://localhost:8080/realms/myrealm/protocol/openid-connect/auth
# OIDC_ACCESS_TOKEN_URL=http://localhost:8080/realms/myrealm/protocol/openid-connect/token
# OIDC_JWT_URL=http://localhost:8080/realms/myrealm/protocol/openid-connect/certs

# Session
SESSION_SECRET_KEY=2gnHEC3puiDzkWab5OoQHJ96Y3xFJ5bWAoc2lc_jXv8
SESSION_COOKIE_MAX_AGE=86400

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/localdisk

# Database
DATABASE_URL=sqlite:///./data/sqlite.db

# Environment
APP_ENV="dev"
APP_VERSION=""

# Rate limiting (slowapi format: "N/second|minute|hour|day")
RATE_LIMIT="60/minute"

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="DEBUG"

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=[[ project_name ]]
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# uncomment only to run without docker compose
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

### Frontend
PUBLIC_API_URL=http://app.localhost/api
PUBLIC_BASE_URL=http://app.localhost
# uncomment only to run without docker compose
# PUBLIC_API_URL=http://localhost:8000
# PUBLIC_BASE_URL=http://localhost:5173

### Docker
DATA_VOLUME=./backend/data
